# ─── Custom 404: return proper HTTP 404 status for non-existent URLs ───
# All real pages are pre-rendered static HTML files served automatically.
# Non-existent URLs now return 404 instead of the old SPA fallback (HTTP 200),
# which was causing Google to flag 295+ pages as Soft 404s.
ErrorDocument 404 /index.html

# ─── Security Headers ───
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://c.clarity.ms https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob: https://c.clarity.ms https://c.bing.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://*.doubleclick.net https://*.googlesyndication.com https://*.google.com; object-src 'none'; base-uri 'self';"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ─── GZIP Compression ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# ─── Browser Caching ───
<IfModule mod_expires.c>
  ExpiresActive On

  # Static assets — 1 year (they have hashed filenames)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # HTML — short cache (SPA shell updates)
  ExpiresByType text/html "access plus 10 minutes"

  # Sitemap & robots — 1 day
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

# ─── Prevent directory listing ───
Options -Indexes

# ─── Block access to dotfiles ───
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ─── Correct MIME types ───
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType application/manifest+json .json
  AddType application/xml .xml
</IfModule>
