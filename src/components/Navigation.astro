---
import { navLinks, getLocalizedHref } from '../utils/navigation';

export interface Props {
  region: string;
  activePath?: string;
}

const { region, activePath } = Astro.props;

const isLinkActive = (href: string) => {
  if (!activePath) return false;
  const normHref = href.endsWith('/') ? href : href + '/';
  const normActive = activePath.endsWith('/') ? activePath : activePath + '/';
  if (normHref === '/' || normHref === '/uk/' || normHref === '/ca/' || normHref === '/au/' || normHref === '/nz/' || normHref === '/zh/' || normHref === '/ru/') {
    return normActive === normHref;
  }
  return normActive.startsWith(normHref);
};
---

<div class="md:flex hidden" style="align-items: center; gap: 4px;">
  {navLinks.map((link) => {
    const localizedHref = getLocalizedHref(link.href, region);
    const activeClass = isLinkActive(localizedHref) ? 'active' : '';
    return (
      <a 
        href={localizedHref} 
        class={`nav-link ${activeClass}`}
        style={`padding: 6px 14px; font-size: 14px; font-weight: 500; color: ${isLinkActive(localizedHref) ? 'var(--vercel-ink)' : 'var(--vercel-body)'}; text-decoration: none; display: flex; align-items: center; transition: color 0.2s ease, background 0.2s ease; border-radius: var(--vercel-radius-pill);`}
        onmouseover="this.style.color='var(--vercel-ink)'; this.style.background='var(--vercel-canvas-soft)';"
        onmouseout={`this.style.color='${isLinkActive(localizedHref) ? 'var(--vercel-ink)' : 'var(--vercel-body)'}'; this.style.background='transparent';`}
      >
        {link.label}
      </a>
    );
  })}
</div>
