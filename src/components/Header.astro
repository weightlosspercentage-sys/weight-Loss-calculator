---
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import { getLocalizedHref } from '../utils/navigation';

export interface Props {
  activePath?: string;
  region: string;
}

const { region, activePath } = Astro.props;
---

<header class="static-header" style="position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--vercel-hairline); min-height: 64px; display: flex; align-items: center; justify-content: center; padding: 0 16px;">
  <div style="max-width: 1400px; width: 100%; display: flex; justify-content: space-between; align-items: center;">
    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; gap: 1rem;">
      <!-- Logo -->
      <a href={getLocalizedHref('/', region)} style="font-weight: 700; font-size: 1.25rem; text-decoration: none; color: #0f172a; display: flex; align-items: center; gap: 0.5rem;" aria-label="Weight Loss Percentage - Home">
        <span style="background: linear-gradient(135deg, #3b82f6, #8b5cf6, #f97316); color: white; border-radius: 8px; width: 2.25rem; height: 2.25rem; display: flex; align-items: center; justify-content: center; font-weight: 800;">%</span>
        <span style="font-weight: 700; color: #0f172a; font-size: 1.125rem;">Weight Loss Percentage</span>
      </a>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <!-- Desktop Navigation -->
        <Navigation region={region} activePath={activePath} />
      </div>

      <!-- Mobile Hamburger -->
      <button id="mobile-menu-btn" aria-label="Open menu" class="md:hidden" style="display: flex; align-items: center; justify-content: center; height: 44px; width: 44px; border: none; background: transparent; cursor: pointer; color: var(--vercel-ink);">
        <svg style="height: 24px; width: 24px;" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <MobileMenu region={region} />
</header>

<style is:global>
  /* Google Translate custom widget styling */
  .goog-te-gadget-simple {
    background-color: #f8fafc !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 20px !important;
    padding: 3px 10px !important;
    font-size: 13px !important;
    font-family: inherit !important;
    display: inline-flex !important;
    align-items: center !important;
    cursor: pointer !important;
  }
  .goog-te-gadget-simple .goog-te-menu-value span {
    color: #334155 !important;
    font-weight: 500 !important;
  }
  .goog-te-gadget-icon {
    display: inline-block !important;
    margin-right: 4px !important;
  }
  body {
    top: 0px !important;
  }
  .goog-te-banner-frame {
    display: none !important;
  }
</style>

<script is:inline>
  // The picker is a footer control: the header row has no spare width at desktop
  // and translating is not a navigation action. Google renders into whichever id
  // it is handed, so the container is created in the footer copyright bar and any
  // legacy header copy is moved there. React replaces #root's children, so on SPA
  // pages the footer we must wait for is the bundle's own.
  var GT_LANGUAGES = 'es,id,pt,fr,ar,de';

  // Once React mounts, createRoot(#root).render() leaves exactly one visible
  // <footer> per route — the bundle's own — and .static-footer is no longer in the
  // DOM. Before the mount, .static-footer is the only footer there is, so picking
  // querySelector('footer') at the first poll tick attaches the widget to a node on
  // its way out. Wait for the real one; pages that never load the bundle take
  // .static-footer straight away.
  function gtHasSpa() {
    return !!document.querySelector('script[src*="/assets/index-"]');
  }

  // Returns the footer plus whether it is the pre-rendered static one. A static
  // footer is not allowed to host the container: if TranslateElement renders into a
  // node nested inside .static-footer, the gadget's click replaces the document
  // before the popup opens. One node outside it, as the footer's preceding sibling,
  // opens normally. Ruled out as the cause: overlapping footer links, an <a> or
  // <form> ancestor, and a transform ancestor — relocating an already-rendered
  // gadget into that same footer works, so it is the position at render time.
  function gtBar(keepStatic) {
    var fs = document.querySelectorAll('footer');
    for (var k = 0; k < fs.length; k++) {
      if (fs[k].className.indexOf('static-footer') < 0) return { footer: fs[k], stat: false };
    }
    if (keepStatic || !gtHasSpa()) return fs.length ? { footer: fs[0], stat: true } : null;
    return null;
  }

  function gtHost(keepStatic) {
    var bar = gtBar(keepStatic);
    if (!bar) return null;
    var el = document.getElementById('google_translate_element');
    if (!el) {
      el = document.createElement('div');
      el.id = 'google_translate_element';
    }
    el.className = 'notranslate';
    if (bar.stat) {
      // The footer's own parent, not document.body: insertBefore throws if the
      // reference node is not a child of the node it is called on, and this runs
      // from a 200ms poll.
      var par = bar.footer.parentNode || document.body;
      if (el.parentNode !== par || el.nextElementSibling !== bar.footer) {
        el.style.cssText = 'display:flex;justify-content:flex-end;max-width:1400px;margin:14px auto 0;padding:0 24px;';
        par.insertBefore(el, bar.footer);
      }
      return el;
    }
    var host = bar.footer;
    var ps = host.querySelectorAll('p');
    for (var i = 0; i < ps.length; i++) {
      if (/©|All rights reserved/.test(ps[i].textContent || '')) {
        host = ps[i].parentElement || host;
        break;
      }
    }
    if (el.parentNode !== host) {
      el.style.cssText = 'display:flex;justify-content:flex-end;margin-top:14px;';
      host.appendChild(el);
    }
    return el;
  }

  window.googleTranslateElementInit = function () {
    // element.js calls this once. Re-resolve with the same preference the poll used:
    // the React footer first, .static-footer only if that is all there is. Passing
    // keepStatic straight through would re-parent the container back onto the
    // static footer whenever React happened to mount in between.
    var host = gtHost(false) || gtHost(true);
    if (!host) return;
    try {
      new google.translate.TranslateElement({
        pageLanguage: 'en',
        includedLanguages: GT_LANGUAGES,
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
        autoDisplay: true
      }, 'google_translate_element');
    } catch (e) {
      // Swallowing this made a dead widget indistinguishable from a working
      // one while diagnosing why no dropdown ever appeared.
      console.warn('[translate] TranslateElement failed for #google_translate_element:', e && e.message);
    }
  };

  (function () {
    function load() {
      if (document.getElementById('google-translate-script')) return;
      // element.js pulls a large payload for a control no first-time visitor is
      // looking for, so hand the append to the first CPU idle. Capped at 3s and
      // not chained to window "load", which ads delay by many seconds.
      var gtScript = document.createElement('script');
      gtScript.id = 'google-translate-script';
      gtScript.type = 'text/javascript';
      gtScript.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
      document.head.appendChild(gtScript);
    }

    var attempts = 0;
    var timer = setInterval(function () {
      attempts++;
      // Past 8s React is not coming, so a hidden .static-footer is the best host.
      if (gtHost(attempts >= 40)) {
        clearInterval(timer);
        if (window.requestIdleCallback) requestIdleCallback(load, { timeout: 3000 });
        else setTimeout(load, 1200);
        return;
      }
      if (attempts >= 50) clearInterval(timer);
    }, 200);
  })();


  document.getElementById('mobile-menu-btn')?.addEventListener('click', function() {
    var m = document.getElementById('mobile-menu');
    if (m) {
      if (m.classList.contains('hidden')) {
        m.classList.remove('hidden');
        requestAnimationFrame(function() {
          m.style.maxHeight = m.scrollHeight + 'px';
          m.style.opacity = '1';
        });
      } else {
        m.style.maxHeight = '0px';
        m.style.opacity = '0';
        m.addEventListener('transitionend', function handler(e) {
          if (e.propertyName === 'max-height') {
            m.classList.add('hidden');
            m.removeEventListener('transitionend', handler);
          }
        });
      }
      var isHidden = m.classList.contains('hidden');
      this.setAttribute('aria-label', isHidden ? 'Open menu' : 'Close menu');
    }
  });
</script>

