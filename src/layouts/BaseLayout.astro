---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { SPA_NAV_GUARD_SCRIPT } from '../utils/spaNavGuard.mjs';

export interface Props {
  lang?: string;
  title?: string;
  description?: string;
  canonical?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  metaTags?: Array<{ name?: string; property?: string; content: string }>;
  schemas?: string[];
  activePath?: string;
  region: string;
  loadReact?: boolean;
}

const {
  lang = 'en',
  title,
  description,
  canonical,
  alternates,
  metaTags = [],
  schemas,
  activePath = '',
  region,
  loadReact = false
} = Astro.props;

// Build a production-absolute canonical. Never fall back to Astro.url.href,
// which resolves to http://localhost:4321 during the build and blocks indexing.
const siteOrigin = (Astro.site ?? new URL('https://www.weightlosspercentage.com')).origin;
const resolvedCanonical = canonical && canonical.length > 0
  ? canonical
  : new URL(Astro.url.pathname, siteOrigin).href;

// Ensure thin locales (zh, ru) get <meta name="robots" content="noindex, follow" />
const isThinLocale = lang === 'zh' || lang === 'ru' || region === 'zh' || region === 'ru' || activePath.startsWith('/zh') || activePath.startsWith('/ru');
const finalMetaTags = [...(metaTags || [])];
if (isThinLocale && !finalMetaTags.some(t => t.name === 'robots')) {
  finalMetaTags.push({ name: 'robots', content: 'noindex, follow' });
}

const currentPath = activePath || Astro.url.pathname;
const isCalculatorOrRestaurantSubpage = (currentPath.includes('/calculators/') || currentPath.includes('/restaurants/')) &&
  !currentPath.endsWith('/calculators/') &&
  !currentPath.endsWith('/restaurants/') &&
  !currentPath.endsWith('/fast-food-hub/');
---

<!doctype html>
<html lang={lang} class={loadReact ? 'spa-route' : ''}>
  <head>
    <noscript><style>#layout-loader { display: none !important; }
      html.spa-route .static-header, html.spa-route .static-footer,
      html.spa-route .static-medical-disclaimer { display: revert !important; }
    </style></noscript>
    <link rel="preconnect" href="https://www.ezojs.com" />
    <link rel="preconnect" href="https://ezoicanalytics.com" />
    <link rel="preconnect" href="https://analytics.ahrefs.com" />
    <!-- Ezoic Header Scripts -->
    <script defer src="//www.ezojs.com/ezoic/sa.min.js" is:inline></script>
    <script is:inline>
      window.ezstandalone = window.ezstandalone || {};
      ezstandalone.cmd = ezstandalone.cmd || [];
    </script>
    <script defer src="//ezoicanalytics.com/analytics.js" is:inline></script>

    <!-- Ahrefs Web Analytics -->
    <script defer src="https://analytics.ahrefs.com/analytics.js" data-key="QXNEWlEVlWYHrb6mJIVaUQ" is:inline></script>

    <link rel="preload" href="/assets/index-43gqMy96.css" as="style" fetchpriority="high" />
    <link rel="stylesheet" href="/assets/index-43gqMy96.css" />
    <link rel="stylesheet" href="/assets/vercel-overrides.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <SEO
      title={title}
      description={description}
      canonical={resolvedCanonical}
      alternates={alternates}
      metaTags={finalMetaTags}
      schemas={schemas}
      lang={lang}
    />
    <!-- Security Headers (client-side equivalents) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="geolocation=(), microphone=(), camera=()" />
    <script define:vars={{ region }} is:inline>
      window.__ROUTE_BASEPATH__ = region ? `/${region}` : "/";
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const resultElements = document.querySelectorAll('.result-card, #result, [class*="result-card"], [id*="result-"], [class*="calculator-result"]');
        resultElements.forEach(el => {
          if (!el.hasAttribute('aria-live')) el.setAttribute('aria-live', 'polite');
          if (!el.hasAttribute('role')) el.setAttribute('role', 'status');
        });
      });
    </script>
    
    

    <slot name="head" />
    <style is:global>
      :root {
        --vercel-primary: #171717;
        --vercel-on-primary: #ffffff;
        --vercel-ink: #171717;
        --vercel-body: #4d4d4d;
        --vercel-mute: #888888;
        --vercel-hairline: #ebebeb;
        --vercel-canvas: #ffffff;
        --vercel-canvas-soft: #fafafa;
        --vercel-link: #0070f3;
        --vercel-success: #0070f3;
        --vercel-error: #ee0000;
        --vercel-radius: 6px;
        --vercel-radius-md: 8px;
        --vercel-radius-pill: 100px;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }
      body {
        font-family: var(--font-sans);
        background-color: var(--vercel-canvas-soft);
        color: var(--vercel-ink);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      html {
        overflow-x: hidden;
      }
      h1, h2, h3, h4, h5, h6 {
        letter-spacing: -0.03em;
        font-weight: 600;
      }
      
      /* Critical styles to prevent Flash of Unstyled Content (FOUC) on SPA routes */
      html.spa-route .static-header,
      html.spa-route .static-footer,
      html.spa-route .static-medical-disclaimer {
        display: none !important;
      }

      .hidden { display: none !important; }
      
      /* Base mobile-first display utilities */
      .block { display: block !important; }
      .flex { display: flex !important; }
      .inline-flex { display: inline-flex !important; }
      
      /* Responsive overrides — must be !important to beat the .hidden rule above */
      @media (min-width: 640px) {
        .sm\:block  { display: block  !important; }
        .sm\:flex   { display: flex   !important; }
        .sm\:inline { display: inline !important; }
      }
      @media (min-width: 768px) {
        .md\:flex   { display: flex   !important; }
        .md\:block  { display: block  !important; }
        .md\:hidden { display: none   !important; }
      }
      
      /* Mobile-first: hide desktop nav on small screens, show on md+ */
      @media (max-width: 767px) {
        .md\:flex.hidden { display: none !important; }
      }
      /* Interaction-state overrides — dropdowns use hidden + group-hover:block */
      .group:hover .group-hover\:block,
      .group:focus-within .group-focus-within\:block { display: block !important; }
      .group:hover .group-hover\:flex,
      .group:focus-within .group-focus-within\:flex  { display: flex  !important; }

      /* Prevent duplicate headers/footers when React SPA mounts */
      html.has-react .static-header,
      html.has-react .static-footer,
      html.has-react .static-medical-disclaimer,
      html.has-react #root > header,
      html.has-react #root > footer,
      html.has-react #root > nav,
      html.has-react #root > #mobileMenuScript,
      html.has-react #root > #main-content {
        display: none !important;
      }


      /* Spinner animation for the layout-level loader */
      @keyframes layout-spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
            
      /* Standard layout styles matching index.html */
      .focus-visible-outline { outline: none; }
      .focus-visible-ring:focus-visible { box-shadow: 0 0 0 2px #6366f1; border-radius: 6px; }
      
      /* Dropdown transitions with slide and fade */
      .dropdown-menu {
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        position: absolute;
        z-index: 100;
        transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .group:hover .dropdown-menu,
      .group:focus-within .dropdown-menu {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      
      /* Chevron rotation */
      .dropdown-chevron {
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .group:hover .dropdown-chevron,
      .group:focus-within .dropdown-chevron {
        transform: rotate(180deg);
      }

      /* Navigation active and hover link indicator */
      .nav-link {
        position: relative;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 2px;
        left: 12px;
        right: 12px;
        height: 2px;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6, #f97316);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .nav-link:hover::after,
      .nav-link.active::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      .mobile-details summary::-webkit-details-marker { display: none; }
      .mobile-details[open] .mobile-chevron { transform: rotate(180deg); }
      
      /* Additional utility classes used by components */
      .w-4 { width: 16px; }
      .h-4 { height: 16px; }
      .ml-1 { margin-left: 4px; }
      .space-y-1 > * + * { margin-top: 4px; }
      .px-4 { padding-left: 16px; padding-right: 16px; }
      .py-3 { padding-top: 12px; padding-bottom: 12px; }
      .pb-4 { padding-bottom: 16px; }
      .pl-4 { padding-left: 16px; }
      .mt-1 { margin-top: 4px; }
      .ml-4 { margin-left: 16px; }
      .min-h-11 { min-height: 44px; }
      .text-sm { font-size: 14px; line-height: 20px; }
      .font-medium { font-weight: 500; }
      .font-semibold { font-weight: 600; }
      .rounded-md { border-radius: 6px; }
      .cursor-pointer { cursor: pointer; }
      .list-none { list-style: none; }
      .overflow-hidden { overflow: hidden; }
      .transition-all { transition: all 0.15s ease; }
      .transition-transform { transition: transform 0.2s ease; }
      .duration-300 { transition-duration: 300ms; }
      .duration-200 { transition-duration: 200ms; }
      .ease-in-out { transition-timing-function: ease-in-out; }
      
      /* Color utilities */
      .text-gray-700 { color: #374151; }
      .text-gray-600 { color: #4b5563; }
      .text-indigo-700 { color: #4338ca; }
      .text-orange-700 { color: #c2410c; }
      .text-orange-800 { color: #9a3412; }
      .bg-gray-50 { background-color: #f9fafb; }
      .bg-indigo-50 { background-color: #eef2ff; }
      .bg-orange-50 { background-color: #fff7ed; }
      .hover\:bg-gray-50:hover { background-color: #f9fafb; }
      .hover\:bg-orange-50\/50:hover { background-color: rgba(255, 247, 237, 0.5); }
      .bg-indigo-50\/50 { background-color: rgba(238, 242, 255, 0.5); }
      .border-l-2 { border-left-width: 2px; border-left-style: solid; }
      .border-indigo-100 { border-color: #e0e7ff; }
      
      /* Flexbox utilities */
      .justify-between { justify-content: space-between; }
      .items-center { align-items: center; }
      
      /* Position utilities */
      .relative { position: relative; }
      .absolute { position: absolute; }
      
      /* Group hover behavior for dropdowns */
      .group { position: relative; }
    </style>
  
    <!-- React Hydration & Layout Guard -->
    <script is:inline>
      (function() {
        var observer = null;
        function checkReactMount() {
          var root = document.getElementById('root');
          if (root && root.querySelector('.flex.flex-col.min-h-screen')) {
            document.documentElement.classList.add('has-react');
            var staticFooters = document.querySelectorAll('.static-footer, body > footer, html > footer');
            for (var i = 0; i < staticFooters.length; i++) {
              staticFooters[i].style.display = 'none';
            }
            var staticHeaders = document.querySelectorAll('.static-header, body > header, html > header');
            for (var j = 0; j < staticHeaders.length; j++) {
              staticHeaders[j].style.display = 'none';
            }
            if (observer) {
              observer.disconnect();
              observer = null;
            }
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', checkReactMount);
        } else {
          checkReactMount();
        }
        var rootEl = document.getElementById('root');
        if (rootEl && typeof MutationObserver !== 'undefined') {
          observer = new MutationObserver(checkReactMount);
          observer.observe(rootEl, { childList: true, subtree: true });
          setTimeout(function() {
            if (observer) {
              observer.disconnect();
              observer = null;
            }
          }, 10000);
        }
      })();
    </script>

  </head>
  <body>
    {/* Page loader: only shown for React-loaded pages that need bundle mount time */}
    {loadReact && (
      <div id="layout-loader" style="position: fixed; inset: 0; background: #ffffff; display: flex; align-items: center; justify-content: center; z-index: 9999; pointer-events: none; transition: opacity 0.25s ease;">
        <div style="width: 44px; height: 44px; border: 3px solid #e2e8f0; border-top: 3px solid #4f46e5; border-radius: 50%; animation: layout-spin 0.75s linear infinite;"></div>
      </div>
    )}
    <Header activePath={activePath} region={region} />
    <div id="root">
      <slot />
      
      <!-- Topical Interlinking: Related Calculators (matching GSC keyword clusters) -->
      {isCalculatorOrRestaurantSubpage && (
        <div class="static-related-calculators" style="max-width: 1200px; margin: 2rem auto; padding: 0 1rem;">
          <RelatedCalculators currentSlug={currentPath} region={region} />
        </div>
      )}
      
      <!-- Global Medical Disclaimer & Educational Guidance -->
      <div class="static-medical-disclaimer" style="max-width: 800px; margin: 3rem auto 1rem; padding: 1.5rem; background: #fcfcfc; border: 1px solid #e2e8f0; border-radius: 12px; font-family: sans-serif; text-align: left; color: #475569; font-size: 0.85rem; line-height: 1.5;">
        <div style="margin: 0 0 0.5rem; font-size: 0.95rem; font-weight: 700; color: #1e293b;">Medical Disclaimer & Evidence-Based Guidelines</div>
        <p style="margin: 0 0 0.75rem;">
          <strong>Educational Resource Only:</strong> The metrics, tools, and deficit projections displayed on Weight Loss Percentage are designed to support personal goal tracking and promote healthy weight management. They do not constitute formal medical diagnoses or clinical treatment plans. Please consult a registered dietitian or healthcare professional before embarking on restrictive dieting or intensive physical training.
        </p>
        <p style="margin: 0 0 0.75rem;">
          <strong>Healthy Weight Loss Standards:</strong> Clinical evidence suggests that a safe and sustainable rate of fat loss is approximately 1 to 2 pounds per week (or 0.5% to 1.0% of your total body weight). Rapid weight reduction can lead to metabolic adaptation, lean muscle loss, and nutritional deficiencies. Tracking your weight loss percentage rather than raw pounds provides a more accurate metric of progress relative to your unique frame and initial body mass index.
        </p>
        <p style="margin: 0;">
          <strong>Deficit Projections:</strong> Calculators like BMR, TDEE, and calorie deficit models estimate energy expenditure based on baseline physiological variables. Actual metabolic rates vary due to lean body mass distribution, hormonal health, activity levels, and individual adaptation. Adjust caloric targets gradually while prioritizing nutrient-dense whole foods to optimize energy levels and sustain your metabolic health.
        </p>
      </div>
      
    </div>
    <Footer relativePath={activePath} region={region} />
    {loadReact && <Fragment set:html={SPA_NAV_GUARD_SCRIPT} />}
    <!-- Dismiss loader once React has fully rendered (NOT on window.load —
         window.load can fire before React mounts, exposing the static UI mid-swap) -->
    <script is:inline>
      (function() {
        var dismissed = false;
        function isReactMounted() {
          var root = document.getElementById('root');
          return !!(root && root.querySelector('.flex.flex-col.min-h-screen'));
        }
        function dismissLoader() {
          if (dismissed) return;
          dismissed = true;
          var loader = document.getElementById('layout-loader');
          if (!loader) return;
          loader.style.opacity = '0';
          setTimeout(function() {
            if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
          }, 250);
        }
        function poll() {
          if (isReactMounted()) {
            dismissLoader();
          } else if (!dismissed) {
            setTimeout(poll, 100);
          }
        }
        poll();
        // Safety fallback: if React never mounts (bundle failed/blocked),
        // reveal the static fallback UI so the page is never stuck on a spinner.
        setTimeout(dismissLoader, 4000);
      })();
    </script>
  </body>
</html>
